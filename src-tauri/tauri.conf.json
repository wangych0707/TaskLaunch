{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskLaunch",
  "version": "0.2.1",
  "identifier": "com.tasklaunch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskLaunch",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "task-panel",
        "title": "TaskLaunch · 任务",
        "width": 360,
        "height": 520,
        "minWidth": 280,
        "minHeight": 360,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
